# Pinned by digest: python 3.9 is end-of-life and its tag no longer changes (last push 2025-11-01).
FROM python:3.9@sha256:da5aee29682d12a6649f51c8d6f15b87deb3e6c524b923c41d0cb3304d07c913

COPY ./report-app/src /app/src
COPY /report-app/requirements.txt /app

WORKDIR /app

RUN pip3 install -r requirements.txt

EXPOSE 3000

CMD ["uvicorn",  "--reload", "src.main:app", "--host=0.0.0.0", "--port=3000"]